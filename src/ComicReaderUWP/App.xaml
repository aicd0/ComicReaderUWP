<Application
    x:Class="ComicReaderUWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:main="using:ComicReaderUWP.Views.Pages.Main"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxm="using:Microsoft.UI.Xaml.Media">

    <Application.Resources>
        <muxc:XamlControlsResources>
            <muxc:XamlControlsResources.MergedDictionaries>
                <ResourceDictionary>

                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="AppBackgroundNone" Color="#282828" />
                            <SolidColorBrush x:Key="BusyBackground" Color="#66000000" />
                            <SolidColorBrush x:Key="ComicInfoSeparatorForeground" Color="#404040" />
                            <SolidColorBrush x:Key="ComicItemBackground" Color="#3A3A3A" />
                            <SolidColorBrush x:Key="ComicItemBackgroundPointerOver" Color="#3D3D3D" />
                            <SolidColorBrush x:Key="ComicItemBorderBrush" Color="#3A3A3A" />
                            <SolidColorBrush x:Key="CommandBarBackground" Color="#2D2D2D" />
                            <SolidColorBrush x:Key="CommandBarBorderBrush" Color="#1C1C1C" />
                            <SolidColorBrush x:Key="ForegroundGrey1" Color="#404040" />
                            <SolidColorBrush x:Key="ForegroundGrey2" Color="#858585" />
                            <SolidColorBrush x:Key="HistoryGroupHeaderBackground" Color="#404040" />
                            <SolidColorBrush x:Key="HomeHeaderBackground" Color="#282828" />
                            <SolidColorBrush x:Key="ImagePlaceHolderBackground" Color="#505050" />
                            <SolidColorBrush x:Key="ListViewItemPointerOverBackground1" Color="#505050" />
                            <SolidColorBrush x:Key="ListViewItemPressedBackground1" Color="#555555" />
                            <SolidColorBrush x:Key="NavigationPageTopTileBorderBrush" Color="#000000" />
                            <SolidColorBrush x:Key="PageDemoBrush" Color="#60FFFFFF" />
                            <SolidColorBrush x:Key="ReaderFullscreenBackground" Color="#000000" />
                            <SolidColorBrush x:Key="SettingsListViewBackground" Color="#10000000" />
                            <SolidColorBrush x:Key="SidePaneBorderBrush" Color="#000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#282828" />
                            <SolidColorBrush x:Key="TagButtonBackground" Color="#505050" />
                            <muxm:AcrylicBrush
                                x:Key="TitleBarBackground"
                                FallbackColor="#202020"
                                TintColor="#202020"
                                TintLuminosityOpacity="0.85"
                                TintOpacity="0.8" />
                            <SolidColorBrush x:Key="TipBackground" Color="#373737" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AppBackgroundNone" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="BusyBackground" Color="#66FFFFFF" />
                            <SolidColorBrush x:Key="ComicInfoSeparatorForeground" Color="#D0D0D0" />
                            <SolidColorBrush x:Key="ComicItemBackground" Color="#FDFDFD" />
                            <SolidColorBrush x:Key="ComicItemBackgroundPointerOver" Color="#F0F0F0" />
                            <SolidColorBrush x:Key="ComicItemBorderBrush" Color="#FDE8ED" />
                            <SolidColorBrush x:Key="CommandBarBackground" Color="#F9F9F9" />
                            <SolidColorBrush x:Key="CommandBarBorderBrush" Color="#EBEBEB" />
                            <SolidColorBrush x:Key="ForegroundGrey1" Color="#E0E0E0" />
                            <SolidColorBrush x:Key="ForegroundGrey2" Color="#858585" />
                            <SolidColorBrush x:Key="HistoryGroupHeaderBackground" Color="#DADADA" />
                            <SolidColorBrush x:Key="HomeHeaderBackground" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="ImagePlaceHolderBackground" Color="#E0E0E0" />
                            <SolidColorBrush x:Key="ListViewItemPointerOverBackground1" Color="#E0E0E0" />
                            <SolidColorBrush x:Key="ListViewItemPressedBackground1" Color="#D0D0D0" />
                            <SolidColorBrush x:Key="NavigationPageTopTileBorderBrush" Color="#E6E3EA" />
                            <SolidColorBrush x:Key="PageDemoBrush" Color="#30000000" />
                            <SolidColorBrush x:Key="ReaderFullscreenBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="SettingsListViewBackground" Color="#80FFFFFF" />
                            <SolidColorBrush x:Key="SidePaneBorderBrush" Color="#E6E3EA" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="TagButtonBackground" Color="#DADADA" />
                            <muxm:AcrylicBrush
                                x:Key="TitleBarBackground"
                                FallbackColor="#FFFFFF"
                                TintColor="#FFFFFF"
                                TintLuminosityOpacity="0.85"
                                TintOpacity="0.8" />
                            <SolidColorBrush x:Key="TipBackground" Color="#FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="AppBackgroundNone" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="BusyBackground" Color="#66FFFFFF" />
                            <SolidColorBrush x:Key="ComicInfoSeparatorForeground" Color="#D0D0D0" />
                            <SolidColorBrush x:Key="ComicItemBackground" Color="#FDFDFD" />
                            <SolidColorBrush x:Key="ComicItemBackgroundPointerOver" Color="#F0F0F0" />
                            <SolidColorBrush x:Key="ComicItemBorderBrush" Color="#FDE8ED" />
                            <SolidColorBrush x:Key="CommandBarBackground" Color="#F9F9F9" />
                            <SolidColorBrush x:Key="CommandBarBorderBrush" Color="#EBEBEB" />
                            <SolidColorBrush x:Key="ForegroundGrey1" Color="#E0E0E0" />
                            <SolidColorBrush x:Key="ForegroundGrey2" Color="#858585" />
                            <SolidColorBrush x:Key="HistoryGroupHeaderBackground" Color="#DADADA" />
                            <SolidColorBrush x:Key="HomeHeaderBackground" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="ImagePlaceHolderBackground" Color="#E0E0E0" />
                            <SolidColorBrush x:Key="ListViewItemPointerOverBackground1" Color="#505050" />
                            <SolidColorBrush x:Key="ListViewItemPressedBackground1" Color="#555555" />
                            <SolidColorBrush x:Key="NavigationPageTopTileBorderBrush" Color="#E6E3EA" />
                            <SolidColorBrush x:Key="PageDemoBrush" Color="#000000" />
                            <SolidColorBrush x:Key="ReaderFullscreenBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="SettingsListViewBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="SidePaneBorderBrush" Color="#E6E3EA" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FAF8FC" />
                            <SolidColorBrush x:Key="TagButtonBackground" Color="#DADADA" />
                            <SolidColorBrush x:Key="TitleBarBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="TipBackground" Color="#DADADA" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <x:Double x:Key="AppMinWindowHeight">500</x:Double>
                    <x:Double x:Key="AppMinWindowWidth">480</x:Double>
                    <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
                    <x:Double x:Key="ContentDialogMinHeight">10</x:Double>
                    <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
                    <x:Double x:Key="ContentDialogMinWidth">10</x:Double>
                    <x:Double x:Key="ComicItemVerticalDesiredWidth">160</x:Double>
                    <x:Double x:Key="ComicItemVerticalDesiredHeight">310</x:Double>
                    <x:Double x:Key="ComicItemVerticalImageHeight">150</x:Double>
                    <x:Double x:Key="ComicItemHorizontalDesiredWidth">320</x:Double>
                    <x:Double x:Key="ComicItemHorizontalDesiredHeight">136</x:Double>
                    <x:Double x:Key="ComicItemHorizontalImageWidth">85</x:Double>
                    <x:Double x:Key="ComicItemHorizontalImageHeight">120</x:Double>
                    <x:Double x:Key="ReaderPreviewImageWidth">140</x:Double>
                    <x:Double x:Key="ReaderPreviewImageHeight">200</x:Double>

                    <Style TargetType="main:TitleBar">
                        <Setter Property="ButtonBackground" Value="Transparent" />
                        <Setter Property="ButtonForeground" Value="{ThemeResource SystemControlPageTextBaseHighBrush}" />
                        <Setter Property="ButtonInactiveBackground" Value="Transparent" />
                        <Setter Property="ButtonInactiveForeground" Value="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" />
                        <Setter Property="ButtonHoverBackground" Value="{ThemeResource SystemControlBackgroundListLowBrush}" />
                        <Setter Property="ButtonHoverForeground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                        <Setter Property="ButtonPressedBackground" Value="{ThemeResource SystemControlBackgroundListMediumBrush}" />
                        <Setter Property="ButtonPressedForeground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                    </Style>

                </ResourceDictionary>
            </muxc:XamlControlsResources.MergedDictionaries>
        </muxc:XamlControlsResources>
    </Application.Resources>
</Application>
