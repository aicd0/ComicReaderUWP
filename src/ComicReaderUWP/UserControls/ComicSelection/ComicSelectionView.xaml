<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.ComicSelection.ComicSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adaptivegrid="using:ComicReaderUWP.UserControls.AdaptiveGrid"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:comicitemview="using:ComicReaderUWP.UserControls.ComicItemView"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AdaptiveGridView.xaml" />
                <ResourceDictionary Source="/Styles/GridViewItem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToCollapseGlyphConverter x:Key="BooleanToCollapseGlyphConverter" />

            <Style x:Key="ComicGroupHeaderContainerStyle" TargetType="GridViewHeaderItem">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource GridViewHeaderItemThemeFontSize}" />
                <Setter Property="Background" Value="{ThemeResource GridViewHeaderItemBackground}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewHeaderItem">
                            <StackPanel
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <CollectionViewSource
                x:Name="GroupedItemSource"
                IsSourceGrouped="True"
                ItemsPath="DisplayItems" />

            <DataTemplate x:Name="LargeItemTemplate" x:DataType="vm:ComicItemViewModel">
                <comicitemview:ComicItemVertical />
            </DataTemplate>

            <DataTemplate x:Name="MediumItemTemplate" x:DataType="vm:ComicItemViewModel">
                <comicitemview:ComicItemHorizontal />
            </DataTemplate>

        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid>
        <adaptivegrid:AdaptiveGridView
            x:Name="ItemsGrid"
            ContainerContentChanging="ItemsGrid_ContainerContentChanging"
            Header="{x:Bind HeaderContent, Mode=OneWay}"
            Loaded="ItemsGrid_Loaded"
            SelectionChanged="ItemsGrid_SelectionChanged"
            SelectionMode="{x:Bind ViewModel.ComicItemSelectionMode, Mode=OneWay}"
            StretchContentForSingleRow="False"
            Style="{StaticResource HomePageAdaptiveGridViewStyle}"
            Tapped="ItemsGrid_Tapped"
            Unloaded="ItemsGrid_Unloaded">
            <adaptivegrid:AdaptiveGridView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource ComicGroupHeaderContainerStyle}">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ComicGroupViewModel">
                            <StackPanel Margin="-29,0,8,0" Orientation="Horizontal">
                                <Button
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="GroupCollapseButton_Click">
                                    <FontIcon FontSize="12" Glyph="{x:Bind Collapsed, Converter={StaticResource BooleanToCollapseGlyphConverter}, Mode=OneWay}" />
                                </Button>
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding GroupName}" />
                                <TextBlock
                                    Margin="6,0,5,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource ForegroundGrey2}"
                                    Text="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </adaptivegrid:AdaptiveGridView.GroupStyle>
            <adaptivegrid:AdaptiveGridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid AreStickyGroupHeadersEnabled="False" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </adaptivegrid:AdaptiveGridView.ItemsPanel>
            <adaptivegrid:AdaptiveGridView.Footer>
                <Grid Height="60" Visibility="{x:Bind ViewModel.IsSelectMode, Mode=OneWay}" />
            </adaptivegrid:AdaptiveGridView.Footer>
        </adaptivegrid:AdaptiveGridView>

        <!--  Command Bar  -->
        <Grid
            VerticalAlignment="Bottom"
            Background="{ThemeResource CommandBarBackground}"
            Visibility="{x:Bind ViewModel.IsSelectMode, Mode=OneWay}">
            <StackPanel Margin="6,0" Orientation="Horizontal">
                <AppBarToggleButton
                    x:Uid="SelectAllAppBarButton"
                    Click="SelectAllButton_Click"
                    Icon="SelectAll"
                    IsChecked="{x:Bind ViewModel.IsCommandBarSelectAllToggled, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton
                    Click="FavoriteButton_Click"
                    Icon="Favorite"
                    IsEnabled="{x:Bind ViewModel.IsCommandBarFavoriteEnabled, Mode=OneWay}"
                    Label="{x:Bind StringResource.Favorite}" />
                <AppBarButton
                    Click="UnfavoriteButton_Click"
                    Icon="UnFavorite"
                    IsEnabled="{x:Bind ViewModel.IsCommandBarUnFavoriteEnabled, Mode=OneWay}"
                    Label="{x:Bind StringResource.Unfavorite}" />
                <AppBarButton
                    Click="CompletionStatusButton_Click"
                    Icon="Flag"
                    IsEnabled="{x:Bind ViewModel.IsAnyComicSelected, Mode=OneWay}"
                    Label="{x:Bind StringResource.CompletionStatus}" />
                <AppBarButton
                    Click="HideButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsCommandBarHideEnabled, Mode=OneWay}"
                    Label="{x:Bind StringResource.Hide}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xED1A;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="UnhideButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsCommandBarUnHideEnabled, Mode=OneWay}"
                    Label="{x:Bind StringResource.Unhide}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7B3;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="RemoveButton_Click"
                    IsEnabled="{x:Bind ViewModel.IsAnyComicSelected, Mode=OneWay}"
                    Label="{x:Bind StringResource.Remove}">
                    <AppBarButton.Icon>
                        <FontIcon Foreground="#FF4500" Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>
            <Rectangle
                Height="1"
                VerticalAlignment="Top"
                Fill="{ThemeResource CommandBarBorderBrush}" />
        </Grid>
    </Grid>

</base:BaseUserControl>
