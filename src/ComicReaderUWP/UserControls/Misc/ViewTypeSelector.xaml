<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.Misc.ViewTypeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="32"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <DropDownButton x:Name="MainButton" ToolTipService.ToolTip="{x:Bind StringResource.ViewType}">
        <DropDownButton.Content>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE71D;" />
                <TextBlock Text="{x:Bind StringResource.ViewType}" />
            </StackPanel>
        </DropDownButton.Content>
    </DropDownButton>

</base:BaseUserControl>
