<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.ComicItemView.ComicItemHorizontal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:image="using:ComicReaderUWP.Common.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Tapped="UserControl_Tapped"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="10,8"
        Background="{ThemeResource ButtonBackground}"
        BorderBrush="{ThemeResource ButtonBorderBrush}"
        BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
        ContextRequested="RootGrid_ContextRequested"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        Tapped="RootGrid_Tapped">
        <Grid.BackgroundTransition>
            <BrushTransition Duration="0:0:0.083" />
        </Grid.BackgroundTransition>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="{StaticResource ComicItemHorizontalImageWidth}">
            <image:SimpleImageView
                x:Name="ImageHolder"
                Stretch="UniformToFill"
                Uri="{x:Bind Item.CoverImageUri, Mode=OneWay}" />
        </Grid>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Padding="12,2,8,5"
            Orientation="Vertical"
            Spacing="3">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="14"
                FontWeight="SemiBold"
                MaxLines="3"
                Text="{x:Bind Item.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Opacity="0.6"
                Orientation="Horizontal"
                Visibility="{x:Bind Item.IsRatingVisible, Mode=OneWay}">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind Item.Rating, Mode=OneWay}" />
                <FontIcon
                    Margin="4,1,0,0"
                    FontSize="9"
                    Glyph="&#xE735;" />
            </StackPanel>
            <TextBlock
                FontSize="12"
                FontWeight="SemiLight"
                Opacity="0.6"
                Text="{x:Bind Item.PageCountAndProgress, Mode=OneWay}" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackground}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</base:BaseUserControl>
