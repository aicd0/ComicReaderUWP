<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.Reader.Imaging.ReaderFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    d:DesignHeight="300"
    d:DesignWidth="400"
    DataContextChanged="ReaderFrame_DataContextChanged"
    mc:Ignorable="d">

    <Grid Padding="{x:Bind ViewModel.FrameMargin}">
        <Grid
            x:Name="ImageHost"
            Width="{x:Bind ViewModel.FrameWidth}"
            Height="{x:Bind ViewModel.FrameHeight}"
            VerticalAlignment="Center" />
    </Grid>

</base:BaseUserControl>
