<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.Reader.Imaging.ReaderFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid
        Padding="{x:Bind ViewModel.FrameMargin, Mode=OneWay}"
        Loaded="Boundary_Loaded"
        SizeChanged="Boundary_SizeChanged">
        <Grid
            x:Name="ImageHost"
            Width="{x:Bind ViewModel.FrameWidth, Mode=OneWay}"
            Height="{x:Bind ViewModel.FrameHeight, Mode=OneWay}"
            VerticalAlignment="Center"
            Loaded="ImageHost_Loaded"
            Unloaded="ImageHost_Unloaded" />
    </Grid>

</base:BaseUserControl>
