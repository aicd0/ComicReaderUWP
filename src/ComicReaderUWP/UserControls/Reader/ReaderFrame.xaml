<UserControl
    x:Class="ComicReaderUWP.UserControls.Reader.ReaderFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid
        x:Name="MainFrame"
        Loaded="OnFrameLoaded"
        SizeChanged="OnFrameSizeChanged">
        <Grid Margin="{x:Bind ViewModelNotNull.FrameMargin, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="ImageLeft"
                Grid.Column="0"
                Width="{x:Bind ViewModelNotNull.LeftImageWidth, Mode=OneWay}"
                Height="{x:Bind ViewModelNotNull.LeftImageHeight, Mode=OneWay}"
                VerticalAlignment="Center"
                Source="{x:Bind ViewModelNotNull.ImageLeft, Mode=OneWay}" />
            <Image
                x:Name="ImageRight"
                Grid.Column="1"
                Width="{x:Bind ViewModelNotNull.RightImageWidth, Mode=OneWay}"
                Height="{x:Bind ViewModelNotNull.RightImageHeight, Mode=OneWay}"
                VerticalAlignment="Center"
                Source="{x:Bind ViewModelNotNull.ImageRight, Mode=OneWay}" />
        </Grid>
    </Grid>

</UserControl>
