<base:BaseUserControl
    x:Class="ComicReaderUWP.UserControls.ReaderSettings.SliderSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:ComicReaderUWP.UserControls.ReaderSettings"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <settings:SettingEntryView
        x:Name="Entry"
        EditorWidth="140"
        RowHeight="30"
        ShowValue="True">
        <settings:SettingEntryView.Editor>
            <Slider
                x:Name="MainSlider"
                Margin="0,-2"
                ValueChanged="MainSlider_ValueChanged" />
        </settings:SettingEntryView.Editor>
    </settings:SettingEntryView>

</base:BaseUserControl>