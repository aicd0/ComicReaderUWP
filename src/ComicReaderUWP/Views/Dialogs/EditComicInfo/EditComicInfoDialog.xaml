<base:BaseContentDialog
    x:Class="ComicReaderUWP.Views.Dialogs.EditComicInfo.EditComicInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="{x:Bind StringResource.ComicInfo}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialogPrimaryButtonClick"
    PrimaryButtonText="{x:Bind StringResource.Done}"
    SecondaryButtonClick="ContentDialogSecondaryButtonClick"
    SecondaryButtonText="{x:Bind StringResource.Cancel}"
    mc:Ignorable="d">

    <ScrollView
        Width="600"
        MaxHeight="600"
        VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="Title1NameTextBlock"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" />
            <TextBox
                x:Name="Title1TextBox"
                Grid.Row="0"
                Grid.Column="2"
                TextChanged="Title1TextBox_TextChanged"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="Title2NameTextBlock"
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" />
            <TextBox
                x:Name="Title2TextBox"
                Grid.Row="2"
                Grid.Column="2"
                TextChanged="Title2TextBox_TextChanged"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="DescriptionNameTextBlock"
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" />
            <TextBox
                x:Name="DescriptionTextBox"
                Grid.Row="4"
                Grid.Column="2"
                AcceptsReturn="True"
                TextChanged="DescriptionTextBox_TextChanged"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Text="{x:Bind ViewModel.RatingLabel, Mode=OneWay}" />
            <Grid Grid.Row="6" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    AcceptsReturn="False"
                    BeforeTextChanging="RatingTextBox_BeforeTextChanging"
                    Text="{x:Bind ViewModel.Rating, Mode=OneWay}"
                    TextChanged="RatingTextBox_TextChanged" />
                <CheckBox
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="RatingPercentageCheckBox_Click"
                    Content="%"
                    IsChecked="{x:Bind ViewModel.RatingPercentageEnabled, Mode=OneWay}" />
            </Grid>

            <StackPanel
                Grid.Row="8"
                Grid.Column="2"
                Orientation="Vertical">
                <muxc:InfoBar
                    x:Uid="TagIntroduction"
                    Title="{x:Bind StringResource.Tags}"
                    CloseButtonClick="OnTagInfoBarCloseButtonClicked"
                    IsOpen="{x:Bind ViewModel.IsTagInfoBarOpen, Mode=OneWay}"
                    Severity="Informational" />
                <Grid Height="8" Visibility="{x:Bind ViewModel.IsTagInfoBarOpen, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="9"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="TagNameTextBlock"
                    Margin="0,7,0,0"
                    VerticalAlignment="Top" />
                <Button
                    Margin="6,12.5,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnShowTagInfoButtonClicked">
                    <Button.Content>
                        <FontIcon FontSize="12" Glyph="&#xE946;" />
                    </Button.Content>
                </Button>
            </StackPanel>
            <TextBox
                x:Name="TagTextBox"
                Grid.Row="9"
                Grid.Column="2"
                AcceptsReturn="True"
                TextChanged="TagTextBox_TextChanged"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="10"
                Grid.Column="2"
                Margin="0,4,0,0"
                Orientation="Horizontal">
                <CheckBox
                    MinWidth="0"
                    Click="TagDiffModeCheckBox_Click"
                    Content="{x:Bind StringResource.DiffMode}"
                    IsChecked="True" />
                <CheckBox
                    x:Name="TagIdCheckBox"
                    MinWidth="0"
                    Margin="12,0,0,0"
                    Click="TagIdCheckBox_Click"
                    Content="{x:Bind StringResource.ShowTagId}"
                    IsChecked="False" />
            </StackPanel>

            <TextBlock
                Grid.Row="12"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Text="{x:Bind StringResource.Links}" />
            <controls:EditLinksView
                Grid.Row="12"
                Grid.Column="2"
                Links="{x:Bind ViewModel.Links}" />

            <CheckBox
                Grid.Row="13"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Click="ClearReaderSettingsCheckBox_Click"
                Content="{x:Bind StringResource.ClearReaderSettings}"
                IsChecked="False" />
        </Grid>
    </ScrollView>
</base:BaseContentDialog>
