<base:BaseContentDialog
    x:Class="ComicReaderUWP.Views.Dialogs.EditComicInfo.EditComicInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:chooseImage="using:ComicReaderUWP.UserControls.ChooseImage"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    mc:Ignorable="d">

    <base:BaseContentDialog.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

            <Style x:Key="FieldNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,7,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </base:BaseContentDialog.Resources>

    <StackPanel Orientation="Vertical">
        <muxc:SelectorBar
            x:Name="TabSelectorBar"
            HorizontalAlignment="Left"
            SelectionChanged="TabSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem
                x:Name="GeneralSelectorBarItem"
                Padding="12,0,12,4"
                Text="{x:Bind StringResource.General}" />
            <muxc:SelectorBarItem
                x:Name="ImagesSelectorBarItem"
                Padding="12,0,12,4"
                Text="{x:Bind StringResource.Images}" />
        </muxc:SelectorBar>
        <Rectangle Height="1" Fill="{ThemeResource ComicInfoSeparatorForeground}" />

        <!--  General tab  -->
        <ScrollView
            Width="600"
            MaxHeight="600"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,12,0,0">
                <Grid x:Name="GeneralTabGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title1Label, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.Title1, Mode=OneWay}"
                        TextChanged="Title1TextBox_TextChanged"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title2Label, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.Title2, Mode=OneWay}"
                        TextChanged="Title2TextBox_TextChanged"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.DescriptionLabel, Mode=OneWay}" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="2"
                        AcceptsReturn="True"
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                        TextChanged="DescriptionTextBox_TextChanged"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.RatingLabel, Mode=OneWay}" />
                    <Grid Grid.Row="6" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            AcceptsReturn="False"
                            BeforeTextChanging="RatingTextBox_BeforeTextChanging"
                            Text="{x:Bind ViewModel.Rating, Mode=OneWay}"
                            TextChanged="RatingTextBox_TextChanged" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="RatingPercentageCheckBox_Click"
                            Content="%"
                            IsChecked="{x:Bind ViewModel.RatingPercentageEnabled, Mode=OneWay}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="8"
                        Grid.Column="2"
                        Orientation="Vertical">
                        <muxc:InfoBar
                            x:Uid="TagIntroduction"
                            Title="{x:Bind StringResource.Tags}"
                            CloseButtonClick="OnTagInfoBarCloseButtonClicked"
                            IsOpen="{x:Bind ViewModel.IsTagInfoBarOpen, Mode=OneWay}"
                            Severity="Informational" />
                        <Grid Height="8" Visibility="{x:Bind ViewModel.IsTagInfoBarOpen, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="9"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldNameTextBlockStyle}" Text="{x:Bind ViewModel.TagsLabel, Mode=OneWay}" />
                        <Button
                            Margin="6,12.5,0,0"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnShowTagInfoButtonClicked">
                            <Button.Content>
                                <FontIcon FontSize="12" Glyph="&#xE946;" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <TextBox
                        Grid.Row="9"
                        Grid.Column="2"
                        AcceptsReturn="True"
                        Text="{x:Bind ViewModel.Tags, Mode=OneWay}"
                        TextChanged="TagTextBox_TextChanged"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="10"
                        Grid.Column="2"
                        Margin="0,4,0,0"
                        Orientation="Horizontal">
                        <CheckBox
                            MinWidth="0"
                            Click="TagDiffModeCheckBox_Click"
                            Content="{x:Bind StringResource.DiffMode}"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="TagIdCheckBox"
                            MinWidth="0"
                            Margin="12,0,0,0"
                            Click="TagIdCheckBox_Click"
                            Content="{x:Bind StringResource.ShowTagId}"
                            IsChecked="False" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind StringResource.Links}" />
                    <controls:EditLinksView
                        Grid.Row="12"
                        Grid.Column="2"
                        Links="{x:Bind ViewModel.Links}" />

                    <CheckBox
                        Grid.Row="13"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Click="ClearReaderSettingsCheckBox_Click"
                        Content="{x:Bind StringResource.ClearReaderSettings}"
                        IsChecked="False"
                        Visibility="{x:Bind ViewModel.IsCollectionOnlyMode, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                </Grid>

                <Grid x:Name="ImagesTabGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.CoverImageLabel, Mode=OneWay}" />
                    <chooseImage:ChooseImageView
                        x:Name="CoverImageField"
                        Grid.Row="0"
                        Grid.Column="2" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldNameTextBlockStyle}"
                        Text="{x:Bind ViewModel.BackgroundImageLabel, Mode=OneWay}" />
                    <chooseImage:ChooseImageView
                        x:Name="BackgroundImageField"
                        Grid.Row="2"
                        Grid.Column="2" />

                    <Button
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Left"
                        Click="OpenMetadataFolderButton_Click"
                        Content="{x:Bind StringResource.OpenMetadataFolder}" />
                </Grid>
            </Grid>
        </ScrollView>

        <Grid Margin="0,16,0,0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="DoneButton_Click"
                Content="{x:Bind StringResource.Done}" />
            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                Content="{x:Bind StringResource.Cancel}" />
        </Grid>
    </StackPanel>

</base:BaseContentDialog>
