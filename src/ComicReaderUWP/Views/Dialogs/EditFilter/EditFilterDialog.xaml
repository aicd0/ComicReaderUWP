<base:BaseContentDialog
    x:Class="ComicReaderUWP.Views.Dialogs.EditFilter.EditFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    Title="{x:Bind StringResource.FilterSettings}"
    mc:Ignorable="d">

    <StackPanel Width="600" Orientation="Vertical">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Text="{x:Bind StringResource.Name}" />
            <TextBox
                x:Name="NameTextBox"
                Grid.Row="0"
                Grid.Column="2"
                TextChanged="NameTextBox_TextChanged"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="ExpressionTextBlock"
                    Margin="0,7,0,0"
                    VerticalAlignment="Top" />
                <Button
                    Margin="6,12.5,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ExpressionTipButton_Click">
                    <Button.Content>
                        <FontIcon FontSize="12" Glyph="&#xE946;" />
                    </Button.Content>
                </Button>
            </StackPanel>
            <TextBox
                x:Name="ExpressionTextBox"
                Grid.Row="2"
                Grid.Column="2"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                TextChanged="ExpressionTextBox_TextChanged"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="4"
                Grid.Column="2"
                Orientation="Vertical">
                <TextBlock
                    x:Name="ParseResultTextBlock"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <muxc:ItemsRepeater Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.ExpressionButtons, Mode=OneWay}">
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagViewModel">
                            <controls:TagButton DataContext="{x:Bind}" />
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                    <muxc:ItemsRepeater.Layout>
                        <cwc:WrapLayout HorizontalSpacing="5" VerticalSpacing="5" />
                    </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
            </StackPanel>
        </Grid>
        <CheckBox
            Margin="0,16,0,0"
            Click="IncludeHiddenComicsCheckBox_Click"
            Content="{x:Bind StringResource.IncludeHiddenComics}"
            IsChecked="{x:Bind ViewModel.IncludeHiddenComics, Mode=TwoWay}" />
        <CheckBox
            Click="SaveViewSettingsCheckBox_Click"
            Content="{x:Bind StringResource.SaveViewSettings}"
            IsChecked="{x:Bind ViewModel.SaveViewSettings, Mode=TwoWay}" />
        <CheckBox
            Click="SaveSortingAndGroupingSettingsCheckBox_Click"
            Content="{x:Bind StringResource.SaveSortingAndGroupingSettings}"
            IsChecked="{x:Bind ViewModel.SaveSortingAndGroupingSettings, Mode=TwoWay}" />
        <Grid Margin="0,16,0,0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="{x:Bind StringResource.Save}" />
            <Button
                x:Name="SaveAsNewButton"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="SaveAsNewButton_Click"
                Content="{x:Bind StringResource.New}" />
            <Button
                x:Name="DeleteButton"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                Click="DeleteButton_Click"
                Content="{x:Bind StringResource.Delete}" />
            <Button
                Grid.Column="6"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                Content="{x:Bind StringResource.Cancel}" />
        </Grid>
    </StackPanel>
</base:BaseContentDialog>
