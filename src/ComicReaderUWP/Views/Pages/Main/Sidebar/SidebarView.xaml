<base:BaseUserControl
    x:Class="ComicReaderUWP.Views.Pages.Main.Sidebar.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <muxc:NavigationView
        x:Name="MainNavigationView"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        Loaded="MainNavigationView_Loaded"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <Frame x:Name="ContentFrame" Background="#01FFFFFF" />
        <muxc:NavigationView.PaneFooter>
            <StackPanel Orientation="Vertical">
                <Button
                    Margin="4,1,3,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PinButton_Click"
                    FocusVisualSecondaryBrush="Transparent"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinButtonText, Mode=OneWay}">
                    <Grid Padding="2,4,0,4">
                        <FontIcon FontSize="15.5" Glyph="{x:Bind ViewModel.PinButtonGlyph, Mode=OneWay}" />
                    </Grid>
                </Button>
            </StackPanel>
        </muxc:NavigationView.PaneFooter>
    </muxc:NavigationView>

</base:BaseUserControl>
