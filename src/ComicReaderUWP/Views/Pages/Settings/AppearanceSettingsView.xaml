<base:BaseUserControl
    x:Class="ComicReaderUWP.Views.Pages.Settings.AppearanceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:ComicReaderUWP.Views.Pages.Settings"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <TextBlock
            Margin="0,0,0,8"
            Text="{x:Bind StringResource.ApplyOnNextLaunch}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.AppearanceChanged, Mode=OneWay}" />
        <muxc:RadioButtons
            Margin="0,-8,0,0"
            SelectedIndex="{x:Bind ViewModel.AppearanceIndex, Mode=OneWay}"
            SelectionChanged="AppearanceRadioButtons_SelectionChanged">
            <RadioButton x:Uid="ThemeLight" />
            <RadioButton x:Uid="ThemeDark" />
            <RadioButton x:Uid="ThemeUseSystemSetting" />
        </muxc:RadioButtons>
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="{x:Bind StringResource.Background}" />
            <ComboBox
                Margin="12,0,0,0"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.Backgrounds, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.BackgroundIndex, Mode=OneWay}"
                SelectionChanged="BackgroundComboBox_SelectionChanged" />
        </StackPanel>
    </StackPanel>

</base:BaseUserControl>
