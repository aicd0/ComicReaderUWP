<base:BaseUserControl
    x:Class="ComicReaderUWP.Views.Pages.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:ComicReaderUWP.Views.Pages.Settings"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <TextBlock
            Margin="0,0,0,12"
            Text="{x:Bind StringResource.ApplyOnNextLaunch}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ApplyOnNextLaunchVisible, Mode=OneWay}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Click="OpenPluginsFolderButton_Click"
                Content="{x:Bind StringResource.OpenPluginsFolder}" />
            <Button
                Grid.Column="1"
                Margin="6,0,0,0"
                Click="InstallPluginButton_Click"
                Content="{x:Bind StringResource.InstallPlugin}" />
            <RichTextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                IsTextSelectionEnabled="False">
                <Paragraph>
                    <Hyperlink Click="DownloadPluginsFromGitHubButton_Click">
                        <Run Text="{x:Bind StringResource.DownloadPluginsFromGitHub}" />
                    </Hyperlink>
                </Paragraph>
            </RichTextBlock>
        </Grid>
        <TextBlock
            Margin="0,12,0,0"
            Text="{x:Bind StringResource.NoPluginsInstalled}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.NoPlugins, Mode=OneWay}" />
        <ListView
            Margin="0,12,0,0"
            Padding="2,3,0,5"
            Background="{ThemeResource SettingsListViewBackground}"
            CornerRadius="4"
            ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.NoPlugins, Mode=OneWay, Converter={StaticResource BooleanToVisibilityNegationConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="settings:PluginItemViewModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                            <IconSourceElement IconSource="{x:Bind Icon, Mode=OneWay}" />
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    Text="{x:Bind Version, Mode=OneWay}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    Text="{x:Bind Publisher, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="{x:Bind Location, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind DescriptionVisible, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind Status, Mode=OneWay}" />
                        <Button
                            Grid.Column="3"
                            Width="32"
                            Height="32"
                            Margin="12,0,0,0"
                            Padding="0"
                            Click="PluginItemMoreButton_Click"
                            ToolTipService.ToolTip="{x:Bind StringResource.More}">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="20,8,12,8" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </StackPanel>

</base:BaseUserControl>
