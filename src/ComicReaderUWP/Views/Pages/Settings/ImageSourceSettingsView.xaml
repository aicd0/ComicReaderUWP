<base:BaseUserControl
    x:Class="ComicReaderUWP.Views.Pages.Settings.ImageSourceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:ComicReaderUWP.Views.Pages.Settings"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Button x:Uid="ChooseLocationButton" Click="ChooseLocationsClick" />
        <Button
            Margin="0,8,0,0"
            Click="EditImportExclusionListButton_Click"
            Content="{x:Bind StringResource.EditImportExclusionList}" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <Button
                x:Uid="RescanFilesButton"
                Click="OnRescanFilesClicked"
                IsEnabled="{x:Bind ViewModel.IsRescanning, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}" />
            <ProgressRing
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsRescanning, Mode=OneWay}" />
        </StackPanel>
        <CheckBox
            Margin="0,16,0,0"
            Click="ScanOnLaunchCheckBox_Click"
            Content="{x:Bind StringResource.ScanOnLaunch}"
            IsChecked="{x:Bind ViewModel.ScanOnLaunch, Mode=OneWay}" />
        <CheckBox
            x:Uid="RemoveUnreachableCheckBox"
            Click="RemoveUnreachableCheckBox_Click"
            IsChecked="{x:Bind ViewModel.RemoveUnreachableComics, Mode=OneWay}" />
        <CheckBox
            Click="PromptBeforeRemovingComicsCheckBox_Click"
            Content="{x:Bind StringResource.PromptBeforeRemovingComics}"
            IsChecked="{x:Bind ViewModel.PromptBeforeRemovingComics, Mode=OneWay}" />
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Uid="ArchiveEncoding"
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="2"
                MinWidth="200"
                DisplayMemberPath="Item1"
                ItemsSource="{x:Bind ViewModel.Encodings, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.DefaultArchiveCodePageIndex, Mode=OneWay}"
                SelectionChanged="DefaultArchiveCodePageComboBox_SelectionChanged" />
        </Grid>
        <Button
            x:Uid="ShowHiddenComicButton"
            Margin="0,32,0,0"
            Click="ShowHiddenComicButton_Click" />
    </StackPanel>

</base:BaseUserControl>
