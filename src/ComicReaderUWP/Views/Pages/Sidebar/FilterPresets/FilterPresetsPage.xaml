<base:BasePage
    x:Class="ComicReaderUWP.Views.Pages.Sidebar.FilterPresets.FilterPresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReaderUWP.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="5,4,6,4"
            Orientation="Vertical">
            <TextBox
                HorizontalAlignment="Stretch"
                PlaceholderText="{x:Bind StringResource.Search}"
                TextChanged="SearchTextBox_TextChanged" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DropDownButton
                    x:Name="FilterPresetDropDownButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE71C;" />
                            <TextBlock x:Name="FilterPresetDropDownTextBlock" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DropDownButton.Content>
                </DropDownButton>
                <Button
                    Grid.Column="1"
                    Width="32"
                    Margin="4,0,0,0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Click="MoreButton_Click"
                    ToolTipService.ToolTip="{x:Bind StringResource.More}">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
            </Grid>
        </StackPanel>
        <TextBlock
            Grid.Row="1"
            Margin="0,10"
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
            Text="{x:Bind StringResource.NoComicsHint}"
            Visibility="{x:Bind ViewModel.NoComicsVisible, Mode=OneWay}" />
        <controls:SimpleTreeView
            Grid.Row="1"
            DataSource="{x:Bind ViewModel.DataSource}"
            SelectionMode="{x:Bind ViewModel.SelectionMode, Mode=TwoWay}" />
    </Grid>

</base:BasePage>
