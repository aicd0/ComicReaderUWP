<base:BasePage
    x:Class="ComicReaderUWP.Views.Pages.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:comicselection="using:ComicReaderUWP.UserControls.ComicSelection"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:search="using:ComicReaderUWP.Views.Pages.Search"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <muxc:ProgressRing
            x:Name="SearchProgressRing"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoadingRingVisible, Mode=OneWay}"
            IsIndeterminate="True" />

        <comicselection:ComicSelectionView
            x:Name="ItemsView"
            ContentPadding="0,15,0,0"
            DataContext="{x:Bind ViewModel.ComicSelection}"
            ItemViewType="Medium">
            <comicselection:ComicSelectionView.HeaderContent>
                <StackPanel Margin="35,0,35,16" Orientation="Vertical">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="14"
                        FontWeight="Normal"
                        Foreground="{ThemeResource ForegroundGrey2}"
                        Text="{x:Bind ViewModel.FilterDetails, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.FilterDetails, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </comicselection:ComicSelectionView.HeaderContent>
        </comicselection:ComicSelectionView>

        <!--  No Results  -->
        <StackPanel
            Margin="10,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="{x:Bind ViewModel.IsNoResultTextVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.NoResultText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Uid="NoResultsDetail"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                FontSize="18" />
        </StackPanel>

    </Grid>
</base:BasePage>
