<base:BasePage
    x:Class="ComicReaderUWP.Views.Pages.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:comicselection="using:ComicReaderUWP.UserControls.ComicSelection"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>

        <comicselection:ComicSelectionView
            x:Name="ItemsView"
            Margin="0,0,-1,0"
            ContentPadding="0,10,0,10"
            DataContext="{x:Bind ViewModel.ComicSelection}"
            GroupCollapseRequested="ItemsView_GroupCollapseRequested"
            ScrollOffsetChanged="ItemsView_ScrollOffsetChanged">
            <comicselection:ComicSelectionView.HeaderContent>
                <StackPanel Orientation="Vertical">
                    <Grid Height="52" />
                    <Grid
                        x:Name="SpLibraryEmpty"
                        Padding="35,30"
                        Visibility="{x:Bind ViewModel.LibraryEmptyVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Margin="12,3,0,0"
                            VerticalAlignment="Top"
                            FontSize="14"
                            Glyph="&#xE946;" />
                        <RichTextBlock
                            Grid.Column="1"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run x:Uid="LibraryEmptyPart1" />
                                <Hyperlink Click="AddFolderHyperlink_Click">
                                    <Run Text="{x:Bind StringResource.AddFolder}" />
                                </Hyperlink>
                                <Run x:Uid="LibraryEmptyPart2" />
                                <Hyperlink Click="RefreshHyperlink_Click">
                                    <Run Text="{x:Bind StringResource.Refresh}" />
                                </Hyperlink>
                                <Run x:Uid="LibraryEmptyPart3" />
                            </Paragraph>
                        </RichTextBlock>
                    </Grid>
                </StackPanel>
            </comicselection:ComicSelectionView.HeaderContent>
        </comicselection:ComicSelectionView>

        <Grid VerticalAlignment="Top">
            <Grid
                x:Name="HeaderAreaBackgroundGrid"
                Background="{ThemeResource TitleBarBackground}"
                IsHitTestVisible="False"
                Opacity="0" />
            <Grid
                x:Name="HeaderAreaGrid"
                Padding="40,20,34,8"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="HeaderTextBlock"
                    x:Uid="LibraryHeader"
                    Grid.Column="0"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Library" />
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="5">
                    <controls:ViewTypeSelector x:Name="ViewTypeSelector" />
                    <DropDownButton x:Name="SortAndGroupDropDownButton">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                                <TextBlock x:Name="SortAndGroupDropDownButtonText" />
                            </StackPanel>
                        </DropDownButton.Content>
                    </DropDownButton>
                    <DropDownButton x:Name="FilterPresetDropDownButton">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                                <TextBlock x:Name="FilterPresetDropDownButtonText" />
                            </StackPanel>
                        </DropDownButton.Content>
                    </DropDownButton>
                    <Button Click="EditFilterButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                <TextBlock Text="{x:Bind StringResource.FilterSettings}" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        Width="32"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        Click="MoreButton_Click"
                        ToolTipService.ToolTip="{x:Bind StringResource.More}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>

</base:BasePage>
