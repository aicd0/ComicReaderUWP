<base:BasePage
    x:Class="ComicReaderUWP.Views.Pages.Reader.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReaderUWP.Common.BaseUI"
    xmlns:controls="using:ComicReaderUWP.UserControls.Misc"
    xmlns:converters="using:ComicReaderUWP.Converters"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwm="using:CommunityToolkit.WinUI.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hotkey="using:ComicReaderUWP.Common.HotKey"
    xmlns:image="using:ComicReaderUWP.Common.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:reader="using:ComicReaderUWP.Views.Pages.Reader"
    xmlns:readercontrol="using:ComicReaderUWP.UserControls.Reader"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppBarButton.xaml" />
                <ResourceDictionary Source="/Styles/Button.xaml" />
                <ResourceDictionary Source="/Styles/RatingControl.xaml" />
                <ResourceDictionary Source="/Styles/TextBox.xaml" />
                <ResourceDictionary Source="/Styles/ToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToDoubleConverter x:Key="BooleanToDoubleConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <cwm:AttachedCardShadow
                x:Key="CommonShadow"
                Opacity="0.1"
                Offset="0" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid x:Name="GMainSection">

            <!--  Background  -->
            <Rectangle
                Fill="{ThemeResource ReaderFullscreenBackground}"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.IsFullscreen, Mode=OneWay}" />
            <image:SimpleImageView
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ImageUri="{x:Bind ViewModel.BackgroundImageUri, Mode=OneWay}"
                IsHitTestVisible="False"
                Stretch="UniformToFill" />
            <Border
                Background="{ThemeResource BackgroundImageAcrylic}"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.BackgroundImageUri, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />

            <!--  Loading status  -->
            <TextBlock
                x:Name="TbReaderStatus"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource ForegroundGrey2}"
                HorizontalTextAlignment="Center" />
            <!--  Reader  -->
            <Grid
                ContextRequested="Reader_ContextRequested"
                PointerEntered="ReaderGrid_PointerEntered"
                PointerExited="ReaderGrid_PointerExited">
                <Grid x:Name="ManipulationReference" />
                <readercontrol:ReaderView x:Name="MainReaderView" />
            </Grid>
            <!--  Playback control  -->
            <StackPanel
                x:Name="BottomGrid"
                VerticalAlignment="Bottom"
                Orientation="Vertical"
                SizeChanged="BottomGrid_SizeChanged">
                <Rectangle Height="1" Fill="{ThemeResource SidePaneBorderBrush}" />
                <StackPanel
                    Padding="8,0,8,12"
                    Background="{ThemeResource TitleBarBackground}"
                    Orientation="Vertical">
                    <Slider
                        x:Name="PlaybackSlider"
                        Margin="4,0"
                        FlowDirection="{x:Bind ViewModel.PreferredFlowDirection, Mode=OneWay}"
                        IsThumbToolTipEnabled="False"
                        Minimum="0.5"
                        StepFrequency="0.01"
                        ValueChanged="PlaybackSlider_ValueChanged" />
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                hotkey:ShortcutToolTip.Action="OpenPreviousComic"
                                hotkey:ShortcutToolTip.Text="{x:Bind StringResource.Previous}"
                                Click="PlaybackPreviousButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsPlaybackPreviousEnabled, Mode=OneWay}"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                                </Button.Content>
                            </Button>
                            <Button
                                hotkey:ShortcutToolTip.Action="ToggleAutoScroll"
                                hotkey:ShortcutToolTip.Text="{x:Bind ViewModel.PlayOrPauseButtonTooltip, Mode=OneWay}"
                                Click="PlaybackPlayButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsAutoPlayEnabled, Mode=OneWay}"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PlayOrPauseButtonGlyph, Mode=OneWay}" />
                                </Button.Content>
                            </Button>
                            <Button
                                hotkey:ShortcutToolTip.Action="OpenNextComic"
                                hotkey:ShortcutToolTip.Text="{x:Bind StringResource.Next}"
                                Click="PlaybackNextButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsPlaybackNextEnabled, Mode=OneWay}"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                                </Button.Content>
                            </Button>
                            <Button
                                Click="PlaybackPlaylistButton_Click"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind StringResource.ReadingList}">
                                <Button.Content>
                                    <FontIcon FontSize="16" Glyph="&#xE7BC;" />
                                </Button.Content>
                            </Button>
                            <Button
                                Click="PlaybackMoreButton_Click"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind StringResource.More}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                </Button.Content>
                            </Button>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <StackPanel
                                Margin="0,0,8,0"
                                Padding="4,0"
                                Background="Transparent"
                                Orientation="Horizontal"
                                PointerWheelChanged="Zooming_PointerWheelChanged">
                                <TextBlock
                                    Margin="0,0,2,2"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{x:Bind ViewModel.Zooming, Mode=OneWay}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource ForegroundGrey2}"
                                    Glyph="&#xEC8F;" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,8,0"
                                Padding="4,0"
                                Background="Transparent"
                                Orientation="Horizontal"
                                PointerWheelChanged="PageIndicator_PointerWheelChanged">
                                <TextBlock
                                    Margin="0,0,2,2"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{x:Bind ViewModel.PrimaryPageIndicatorText, Mode=OneWay}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource ForegroundGrey2}"
                                    Glyph="&#xEC8F;" />
                            </StackPanel>
                            <TextBlock
                                x:Name="PageIndicator2"
                                Margin="0,0,12,2"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource ForegroundGrey2}"
                                Text="{x:Bind ViewModel.SecondaryPageIndicatorText, Mode=OneWay}" />
                            <Button
                                Click="PinButton_Click"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PinButtonText, Mode=OneWay}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PinButtonGlyph, Mode=OneWay}" />
                                </Button.Content>
                            </Button>
                            <Button
                                hotkey:ShortcutToolTip.Action="ToggleFullscreen"
                                hotkey:ShortcutToolTip.Text="{x:Bind ViewModel.FullscreenButtonText, Mode=OneWay}"
                                Click="FullscreenButton_Click"
                                Style="{StaticResource ReaderPlaybackControlButtonStyle}">
                                <Button.Content>
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.FullscreenButtonGlyph, Mode=OneWay}" />
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <!--  Tips  -->
            <muxc:InfoBar
                x:Name="ReaderTip"
                Title="{x:Bind StringResource.Tip}"
                MaxWidth="500"
                Margin="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource TipBackground}"
                CloseButtonClick="ReaderTipCloseButton_Click"
                IsOpen="False"
                Message="{x:Bind StringResource.ReaderTipContent}"
                Severity="Informational" />
        </Grid>
        <!--  Preview grid  -->
        <GridView
            x:Name="PreviewGridView"
            Grid.Row="1"
            Padding="10"
            VerticalAlignment="Center"
            IsItemClickEnabled="True"
            ItemClick="OnGridViewItemClicked"
            ItemsSource="{x:Bind ViewModel.PreviewDataSource}"
            SelectionMode="Single">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="cw:Effects.Shadow" Value="{StaticResource CommonShadow}" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="reader:ReaderPreviewImageViewModel">
                    <reader:ReaderPreviewImage DataContext="{x:Bind}" FlowDirection="LeftToRight" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid HorizontalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>

</base:BasePage>
