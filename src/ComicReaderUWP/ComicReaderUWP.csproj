<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <OutputType>WinExe</OutputType>
    <DefaultLanguage>en</DefaultLanguage>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppInstallerUri>D:\UWP_Installer\</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <UseWinUI>true</UseWinUI>
    <Platforms>x86;x64;ARM64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PublishProfile>win10-$(Platform).pubxml</PublishProfile>
    <CreateMSIXPackage>False</CreateMSIXPackage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageCertificateThumbprint>683F7C9550C08252A5CE282670340C3D302634CF</PackageCertificateThumbprint>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>ComicReaderUWP_TemporaryKey.pfx</PackageCertificateKeyFile>
    <Nullable>enable</Nullable>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>;2008</NoWarn>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <IsPackaged>true</IsPackaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|ARM64'">
    <OutputPath>bin\ARM64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|ARM64'">
    <OutputPath>bin\ARM64\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(IsPackaged)' == 'Debug|true'">
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP;$(Platform)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(IsPackaged)' == 'Debug|false'">
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP;PORTABLE;$(Platform)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(IsPackaged)' == 'Release|true'">
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP;$(Platform)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(IsPackaged)' == 'Release|false'">
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP;PORTABLE;$(Platform)</DefineConstants>
  </PropertyGroup>

  <Target Name="CopyNativeMethods" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="NativeMethods.$(Platform).txt" DestinationFiles="NativeMethods.txt" />
  </Target>
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <Version>2.14.0.0</Version>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>Comic Reader UWP</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="145.0.7606" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.264">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComicReaderUWP.SDK\ComicReaderUWP.SDK.csproj" />
  </ItemGroup>

</Project>
