<base:BaseContentDialog
    x:Class="ComicReader.Views.Dialogs.EditTag.EditTagDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReader.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    Loaded="ContentDialog_Loaded"
    mc:Ignorable="d">

    <base:BaseContentDialog.Resources>
        <ResourceDictionary>

            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

        </ResourceDictionary>
    </base:BaseContentDialog.Resources>

    <StackPanel Width="600" Orientation="Vertical">
        <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,10,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Text="{x:Bind StringResource.Category}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.TagCategoryName, Mode=OneWay}"
                    TextChanged="TagCategoryNameTextBox_TextChanged"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Text="{x:Bind StringResource.Name}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.TagName, Mode=OneWay}"
                    TextChanged="TagNameTextBox_TextChanged"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Text="{x:Bind StringResource.Description}" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="2"
                    AcceptsReturn="True"
                    Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                    TextChanged="DescriptionTextBox_TextChanged"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Text="{x:Bind StringResource.Links}" />
                <ListView
                    Grid.Row="6"
                    Grid.Column="2"
                    ItemsSource="{x:Bind ViewModel.Links}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkItemViewModel">
                            <Grid>
                                <Grid Visibility="{x:Bind IsPlaceholder, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Text="{x:Bind Link, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,0,0"
                                        Content="{x:Bind StringResource.Global}"
                                        IsChecked="{x:Bind Global, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Padding="5,5,4,4"
                                        Click="RemoveLinkButton_Click"
                                        ToolTipService.ToolTip="{x:Bind StringResource.Remove}">
                                        <Button.Content>
                                            <FontIcon FontSize="16" Glyph="&#xE738;" />
                                        </Button.Content>
                                    </Button>
                                </Grid>
                                <StackPanel
                                    MinHeight="36"
                                    Orientation="Horizontal"
                                    Visibility="{x:Bind IsPlaceholder, Mode=OneWay}">
                                    <Button
                                        Padding="5,5,4,4"
                                        VerticalAlignment="Center"
                                        Click="AddLinkButton_Click"
                                        ToolTipService.ToolTip="{x:Bind StringResource.Add}">
                                        <Button.Content>
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>
        <TextBlock Text="{x:Bind StringResource.OverwriteExistingEntries}" Visibility="{x:Bind ViewModel.OverwriteWarning, Mode=OneWay}" />
        <Grid Margin="0,15,0,0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="{x:Bind StringResource.Save}"
                IsEnabled="{x:Bind ViewModel.SaveEnabled, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                Content="{x:Bind StringResource.Cancel}" />
        </Grid>
    </StackPanel>

</base:BaseContentDialog>
