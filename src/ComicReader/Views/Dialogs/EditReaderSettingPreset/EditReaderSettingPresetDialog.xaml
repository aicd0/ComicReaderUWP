<base:BaseContentDialog
    x:Class="ComicReader.Views.Dialogs.EditReaderSettingPreset.EditReaderSettingPresetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls.Misc"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReader.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    mc:Ignorable="d">

    <StackPanel Width="600" Orientation="Vertical">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Text="{x:Bind StringResource.Name}" />
            <TextBox
                Grid.Row="0"
                Grid.Column="2"
                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                TextChanged="NameTextBox_TextChanged"
                TextWrapping="Wrap" />
            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,16,0,0"
                Click="SetAsDefaultCheckBox_Click"
                Content="{x:Bind StringResource.SetAsDefault}"
                IsChecked="{x:Bind ViewModel.SetAsDefault, Mode=OneWay}" />
        </Grid>
        <Grid Margin="0,16,0,0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="{x:Bind StringResource.Save}"
                IsEnabled="{x:Bind ViewModel.SaveEnabled, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="SaveAsNewButton_Click"
                Content="{x:Bind StringResource.New}"
                IsEnabled="{x:Bind ViewModel.SaveAsNewEnabled, Mode=OneWay}" />
            <Button
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                Click="DeleteButton_Click"
                Content="{x:Bind StringResource.Delete}"
                IsEnabled="{x:Bind ViewModel.DeleteEnabled, Mode=OneWay}" />
            <Button
                Grid.Column="6"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                Content="{x:Bind StringResource.Cancel}" />
        </Grid>
    </StackPanel>

</base:BaseContentDialog>
