<base:BasePage
    x:Class="ComicReader.Views.Pages.SidePane.FilterPresets.FilterPresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReader.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="5,4,6,4"
            Orientation="Vertical">
            <TextBox
                HorizontalAlignment="Stretch"
                PlaceholderText="{x:Bind StringResource.Search}"
                TextChanged="SearchTextBox_TextChanged" />
            <DropDownButton
                x:Name="FilterPresetDropDownButton"
                Margin="0,6,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                        <TextBlock x:Name="FilterPresetDropDownTextBlock" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DropDownButton.Content>
            </DropDownButton>
        </StackPanel>
        <controls:SimpleTreeView Grid.Row="1" DataSource="{x:Bind ViewModel.DataSource}" />
    </Grid>

</base:BasePage>
