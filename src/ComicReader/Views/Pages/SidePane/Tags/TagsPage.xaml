<base:BasePage
    x:Class="ComicReader.Views.Pages.SidePane.Tags.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:ComicReader.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>

        <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <DataTemplate x:Key="NormalTemplate" x:DataType="vm:TagNodeViewModel">
            <muxc:TreeViewItem
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AllowDrop="False"
                AutomationProperties.Name="{x:Bind Title}"
                ContextFlyout="{x:Bind ContextFlyout, Mode=OneWay}"
                IsExpanded="{x:Bind Expanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Children}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="24">
                        <Grid Visibility="{x:Bind CanExpand, Mode=OneWay}">
                            <FontIcon
                                Margin="0,2,0,0"
                                FontSize="16"
                                Glyph="{x:Bind Glyph, Mode=OneWay}"
                                Visibility="{x:Bind Expanded, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                            <FontIcon
                                Margin="0,2,0,0"
                                FontSize="16"
                                Glyph="{x:Bind Glyph, Mode=OneWay}"
                                Visibility="{x:Bind Expanded, Mode=OneWay}" />
                        </Grid>
                        <FontIcon
                            Margin="0,2,0,0"
                            FontSize="16"
                            Glyph="{x:Bind Glyph, Mode=OneWay}"
                            Visibility="{x:Bind CanExpand, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource ForegroundGrey2}"
                        Text="{x:Bind Description, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </muxc:TreeViewItem>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <TextBlock
            x:Name="NoContentTextBlock"
            Margin="0,10"
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
            Text="{x:Bind StringResource.NoResults}"
            Visibility="{x:Bind ViewModel.NoTagsVisible, Mode=OneWay}" />
        <muxc:TreeView
            ItemInvoked="TreeView_ItemInvoked"
            ItemTemplate="{StaticResource NormalTemplate}"
            ItemsSource="{x:Bind ViewModel.DataSource}" />
    </Grid>

</base:BasePage>
