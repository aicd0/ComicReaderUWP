<base:BasePage
    x:Class="ComicReader.Views.Pages.Settings.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:ComicReader.Views.Pages.Settings"
    xmlns:triggers="using:ComicReader.Triggers"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            Padding="30,0,25,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid x:Name="ContentGrid" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition x:Name="ColumnMiddle" Width="50" />
                    <ColumnDefinition x:Name="ColumnRight" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,25,0,0"
                    Orientation="Vertical"
                    Spacing="5">

                    <!--  General  -->
                    <settings:SettingExpander
                        Detail="{x:Bind StringResource.GeneralSettingsDescription}"
                        Glyph="&#xE713;"
                        Header="{x:Bind StringResource.General}"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <settings:GeneralSettingsView x:Name="GeneralSettingsSection" />
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Image Source  -->
                    <settings:SettingExpander
                        x:Uid="ImageLocationExpander"
                        Glyph="&#xEB9F;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <Button x:Uid="ChooseLocationButton" Click="ChooseLocationsClick" />
                                <CheckBox
                                    Margin="0,12,0,0"
                                    Click="ScanOnLaunchCheckBox_Click"
                                    Content="{x:Bind StringResource.ScanOnLaunch}"
                                    IsChecked="{x:Bind ViewModel.ScanOnLaunch, Mode=OneWay}" />
                                <CheckBox
                                    x:Uid="RemoveUnreachableCheckBox"
                                    Click="RemoveUnreachableCheckBox_Click"
                                    IsChecked="{x:Bind ViewModel.RemoveUnreachableComics, Mode=OneWay}" />
                                <CheckBox
                                    Click="PromptBeforeRemovingComicsCheckBox_Click"
                                    Content="{x:Bind StringResource.PromptBeforeRemovingComics}"
                                    IsChecked="{x:Bind ViewModel.PromptBeforeRemovingComics, Mode=OneWay}" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button
                                        x:Uid="RescanFilesButton"
                                        Click="OnRescanFilesClicked"
                                        IsEnabled="{x:Bind ViewModel.IsRescanning, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}" />
                                    <ProgressRing
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind ViewModel.IsRescanning, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    x:Uid="ShowHiddenComicButton"
                                    Margin="0,8,0,0"
                                    Click="ShowHiddenComicButton_Click" />
                                <TextBlock x:Uid="ArchiveEncoding" Margin="0,12,0,0" />
                                <ComboBox
                                    MinWidth="200"
                                    Margin="0,8,0,0"
                                    DisplayMemberPath="Item1"
                                    ItemsSource="{x:Bind ViewModel.Encodings, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.DefaultArchiveCodePageIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Reader  -->
                    <settings:SettingExpander
                        x:Uid="ReaderExpander"
                        Glyph="&#xE736;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Uid="TransitionAnimation" TextWrapping="Wrap" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.TransitionAnimation, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Text="{x:Bind StringResource.HideCursorAutomatically}"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AutomaticallyHideCursor, Mode=TwoWay}" />
                                <TextBlock
                                    x:Uid="AntiAliasingFilter"
                                    Margin="0,12,0,0"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AntiAliasingEnabled, Mode=TwoWay}" />
                                <CheckBox
                                    Margin="0,16,0,0"
                                    Click="RestoreLastReadingPositionCheckBox_Click"
                                    Content="{x:Bind StringResource.RestoreLastReadingPosition}"
                                    IsChecked="{x:Bind ViewModel.RestoreLastReadingPosition, Mode=OneWay}" />
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  History  -->
                    <settings:SettingExpander
                        x:Uid="HistoryExpander"
                        Glyph="&#xE81C;"
                        Header="{x:Bind StringResource.History}"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <Button
                                    x:Uid="ClearAllHistoryButton"
                                    Click="OnHistoryClearAllClicked"
                                    IsEnabled="{x:Bind ViewModel.IsClearHistoryEnabled, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="SaveHistory"
                                    Margin="0,20,0,0"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.HistorySaveBrowsingHistory, Mode=TwoWay}" />
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Appearance  -->
                    <settings:SettingExpander
                        x:Uid="AppearanceExpander"
                        Glyph="&#xE790;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Text="{x:Bind StringResource.ApplyOnNextLaunch}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.AppearanceChanged, Mode=OneWay}" />
                                <muxc:RadioButtons Margin="0,-8,0,0">
                                    <RadioButton x:Uid="ThemeLight" IsChecked="{x:Bind ViewModel.AppearanceLightChecked, Mode=TwoWay}" />
                                    <RadioButton x:Uid="ThemeDark" IsChecked="{x:Bind ViewModel.AppearanceDarkChecked, Mode=TwoWay}" />
                                    <RadioButton x:Uid="ThemeUseSystemSetting" IsChecked="{x:Bind ViewModel.AppearanceUseSystemSettingChecked, Mode=TwoWay}" />
                                </muxc:RadioButtons>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind StringResource.Background}" />
                                    <ComboBox
                                        Margin="12,0,0,0"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{x:Bind ViewModel.Backgrounds, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.BackgroundIndex, Mode=OneWay}"
                                        SelectionChanged="BackgroundComboBox_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Language  -->
                    <settings:SettingExpander
                        x:Uid="LanguageExpander"
                        Glyph="&#xF2B7;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Text="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.LanguageDescription, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                <ComboBox
                                    MinWidth="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=OneWay}"
                                    SelectionChanged="LanguageComboBox_SelectionChanged" />
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Keyboard shortcuts  -->
                    <settings:SettingExpander
                        x:Uid="KeyboardShortcutsExpander"
                        Glyph="&#xE92E;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1000*" MaxWidth="350" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,0,2"
                                    Orientation="Vertical">
                                    <settings:HotkeyInfo Key="PgDn" x:Uid="HotkeyNextPage" />
                                    <settings:HotkeyInfo Key="PgUp" x:Uid="HotkeyPreviousPage" />
                                    <settings:HotkeyInfo Key="Home" x:Uid="HotkeyFirstPage" />
                                    <settings:HotkeyInfo Key="End" x:Uid="HotkeyLastPage" />
                                    <settings:HotkeyInfo Key="R" x:Uid="HotkeyRandomPage" />
                                    <settings:HotkeyInfo Key="Space" Header="{x:Bind StringResource.ToggleAutoScroll}" />
                                </StackPanel>
                            </Grid>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Plugins  -->
                    <settings:SettingExpander
                        Detail="{x:Bind StringResource.PluginSettingsDescription}"
                        Glyph="&#xE74C;"
                        Header="{x:Bind StringResource.Plugins}"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <settings:PluginSettingsView x:Name="PluginSettingsSection" />
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                    <!--  Advanced  -->
                    <settings:SettingExpander
                        x:Uid="AdvancedExpander"
                        Glyph="&#xEC7A;"
                        IsExpanded="False">
                        <settings:SettingExpander.InnerContent>
                            <StackPanel Orientation="Vertical">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        x:Uid="ClearCacheButton"
                                        Click="OnClearCacheClick"
                                        IsEnabled="{x:Bind ViewModel.IsClearingCache, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}" />
                                    <ProgressRing
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind ViewModel.IsClearingCache, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{ThemeResource ForegroundGrey2}"
                                    Text="{x:Bind ViewModel.CacheSize, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Margin="0,16,0,0"
                                    Click="OnOpenUserDataFolderClick"
                                    Content="{x:Bind StringResource.OpenUserDataFolder}" />
                                <Button
                                    Margin="0,8,0,0"
                                    Click="OnRefreshRandomSeedClick"
                                    Content="{x:Bind StringResource.RefreshRandomSeed}" />
                                <TextBlock
                                    x:Uid="DebugMode"
                                    Margin="0,20,0,0"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    x:Name="TsDebugMode"
                                    IsOn="{x:Bind ViewModel.DebugMode, Mode=OneWay}"
                                    Toggled="OnDebugModeToggled" />
                            </StackPanel>
                        </settings:SettingExpander.InnerContent>
                    </settings:SettingExpander>

                </StackPanel>

                <StackPanel
                    x:Name="RightColumnContent"
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Vertical">

                    <!--  Statistics  -->
                    <TextBlock Style="{StaticResource SettingsPageSubTitleTextBlock}" Text="{x:Bind StringResource.Statistics}" />
                    <TextBlock Text="{x:Bind ViewModel.StatisticText, Mode=OneWay}" TextWrapping="Wrap" />

                    <!--  Feedback  -->
                    <TextBlock x:Uid="Feedback" Style="{StaticResource SettingsPageSubTitleTextBlock}" />
                    <TextBlock
                        x:Uid="FeedbackIntroduction"
                        Margin="3,0,0,0"
                        TextWrapping="Wrap" />
                    <Button
                        x:Uid="SendFeedbackButton"
                        Margin="0,10,0,0"
                        Click="OnSendFeedbackButtonClicked" />
                    <RichTextBlock Margin="3,8,0,0" IsTextSelectionEnabled="False">
                        <Paragraph>
                            <Run x:Name="ContributionRunBeforeLink" />
                            <Hyperlink NavigateUri="https://github.com/aicd0/ComicReaderUWP">
                                <Run Text="GitHub" />
                            </Hyperlink>
                            <Run x:Name="ContributionRunAfterLink" />
                        </Paragraph>
                    </RichTextBlock>
                    <StackPanel
                        Margin="3,0,0,0"
                        Orientation="Vertical"
                        Visibility="{x:Bind ViewModel.IsDonor, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}">
                        <RichTextBlock Margin="0,8,0,0" IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run Text="{x:Bind StringResource.DonationDescription}" />
                                <Hyperlink Click="DonationAlreadyPurchasedHyperlink_Click">
                                    <Run Text="{x:Bind StringResource.DonationAlreadyPurchased}" />
                                </Hyperlink>
                            </Paragraph>
                        </RichTextBlock>
                        <Button
                            Margin="0,10,0,0"
                            Click="DonationButton_Click"
                            Content="{x:Bind StringResource.DonationBuyMeACoffee}" />
                    </StackPanel>
                    <RichTextBlock
                        Margin="3,8,0,0"
                        IsTextSelectionEnabled="False"
                        Visibility="{x:Bind ViewModel.IsDonor, Mode=OneWay}">
                        <Paragraph>
                            <Run FontWeight="Bold" Text="{x:Bind StringResource.DonationSuccess}" />
                            <InlineUIContainer>
                                <FontIcon
                                    Margin="0,0,0,-3"
                                    FontSize="13"
                                    Foreground="Red"
                                    Glyph="&#xEB52;" />
                            </InlineUIContainer>
                            <InlineUIContainer>
                                <FontIcon
                                    Margin="0,0,0,-3"
                                    FontSize="13"
                                    Foreground="Red"
                                    Glyph="&#xEB52;" />
                            </InlineUIContainer>
                            <InlineUIContainer>
                                <FontIcon
                                    Margin="0,0,0,-3"
                                    FontSize="13"
                                    Foreground="Red"
                                    Glyph="&#xEB52;" />
                            </InlineUIContainer>
                        </Paragraph>
                    </RichTextBlock>

                    <!--  About  -->
                    <TextBlock Style="{StaticResource SettingsPageSubTitleTextBlock}" Text="{x:Bind StringResource.About}" />
                    <TextBlock
                        x:Name="AboutBuildVersionControl"
                        Margin="3,0,0,0"
                        Text="AboutBuildVersion"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="AboutCopyrightControl"
                        Margin="3,0,0,0"
                        Text="© AboutCopyright"
                        TextWrapping="Wrap" />
                    <Grid Height="8" />
                    <RichTextBlock
                        Margin="3,0,0,0"
                        HorizontalAlignment="Left"
                        IsTextSelectionEnabled="False">
                        <Paragraph>
                            <Hyperlink NavigateUri="https://github.com/aicd0/ComicReaderUWP/blob/develop/docs/PrivacyPolicy.md">
                                <Run x:Uid="PrivacyPolicy" />
                            </Hyperlink>
                        </Paragraph>
                    </RichTextBlock>

                    <!--  Disclaimer  -->
                    <TextBlock x:Uid="Disclaimer" Style="{StaticResource SettingsPageSubTitleTextBlock}" />
                    <TextBlock
                        Margin="3,0,0,0"
                        IsTextSelectionEnabled="True"
                        Text="THE SOFTWARE IS PROVIDED &quot;AS IS&quot;, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE."
                        TextWrapping="Wrap" />

                    <!--  Debug information  -->
                    <StackPanel Orientation="Vertical" Visibility="{x:Bind ViewModel.DebugMode, Mode=OneWay}">
                        <TextBlock x:Uid="DebugInformation" Style="{StaticResource SettingsPageSubTitleTextBlock}" />
                        <TextBlock
                            x:Name="TbDebugInformation"
                            Margin="3,0,0,0"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="LargeWideView">
                    <VisualState.StateTriggers>
                        <triggers:SizeTrigger
                            MinWidth="820"
                            MinHeight="0"
                            Target="{x:Bind ContentGrid}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="SideVisible">
                    <VisualState.StateTriggers>
                        <triggers:SizeTrigger
                            MinWidth="0"
                            MinHeight="0"
                            Target="{x:Bind ContentGrid}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ColumnMiddle.Width" Value="0" />
                        <Setter Target="ColumnRight.Width" Value="0" />
                        <Setter Target="RightColumnContent.(Grid.Column)" Value="0" />
                        <Setter Target="RightColumnContent.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</base:BasePage>
