<base:BaseUserControl
    x:Class="ComicReader.Views.Pages.Settings.GeneralSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:settings="using:ComicReader.Views.Pages.Settings"
    xmlns:vm="using:ComicReader.ViewModels"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />
        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.CloseLastTabBehavior}"
                TextWrapping="Wrap" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="2"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.CloseLastTabBehaviors, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.CloseLastTabBehaviorIndex, Mode=OneWay}"
                SelectionChanged="CloseLastTabBehaviorBehaviorComboBox_SelectionChanged" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind StringResource.OpenComicDefaultBehavior}"
                TextWrapping="Wrap" />
            <ComboBox
                Grid.Row="2"
                Grid.Column="2"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.OpenComicDefaultBaheviors, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.OpenComicDefaultBaheviorIndex, Mode=OneWay}"
                SelectionChanged="OpenComicDefaultBehaviorComboBox_SelectionChanged" />
        </Grid>
    </StackPanel>

</base:BaseUserControl>
