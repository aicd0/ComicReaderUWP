<base:BasePage
    x:Class="ComicReader.Views.Pages.DevTools.DevToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="16" Orientation="Vertical">

                <TextBlock x:Name="TbOperationResult" Foreground="Yellow" />

                <Grid Height="16" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="CrashAppButton_Click" Content="Crash the app" />
                    <Button Click="TriggerAssertFailureButton_Click" Content="Trigger assert failure" />
                </StackPanel>
                <Grid Height="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnSyncFileNameClick" Content="Sync file name" />
                    <Button Click="OnShowDialogOnActiveWindowClick" Content="Show dialog on active window" />
                </StackPanel>
                <Grid Height="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnPrintMemoryLeakReportClick" Content="Print memory leak report" />
                </StackPanel>

                <Grid Height="16" />

                <TextBox
                    x:Name="TbCommonConfigs"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap" />
                <Grid Height="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCommonConfigsApplyClick" Content="Apply" />
                    <Button Click="OnCommonConfigsRestoreClick" Content="Restore" />
                </StackPanel>

                <Grid Height="16" />

                <TextBlock Text="Developer mode" />
                <ToggleSwitch x:Name="DeveloperModeToggleSwitch" Toggled="DeveloperModeToggleSwitch_Toggled" />
                <TextBlock Text="Sentry" />
                <ToggleSwitch x:Name="SentryToggleSwitch" Toggled="SentryToggleSwitch_Toggled" />

            </StackPanel>
        </ScrollViewer>
    </Grid>

</base:BasePage>
