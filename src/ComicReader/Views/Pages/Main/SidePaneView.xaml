<base:BaseUserControl
    x:Class="ComicReader.Views.Pages.Main.SidePaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <muxc:NavigationView
        x:Name="MainNavigationView"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavPaneSelectionChanged">
        <Frame x:Name="ContentFrame" Background="#01FFFFFF" />
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Name="Favorites" ToolTipService.ToolTip="{x:Bind StringResource.Favorites}">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE728;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Name="History" ToolTipService.ToolTip="{x:Bind StringResource.History}">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Name="Folders" ToolTipService.ToolTip="{x:Bind StringResource.Folders}">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Name="Tags" ToolTipService.ToolTip="{x:Bind StringResource.Tags}">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Name="FilterPresets" ToolTipService.ToolTip="{x:Bind StringResource.FilterPresets}">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>
        <muxc:NavigationView.PaneFooter>
            <StackPanel Orientation="Vertical">
                <Button
                    Margin="4,1,3,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PinButton_Click"
                    FocusVisualSecondaryBrush="Transparent"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PinButtonText, Mode=OneWay}">
                    <Grid Padding="2,4,0,4">
                        <FontIcon FontSize="15.5" Glyph="{x:Bind ViewModel.PinButtonGlyph, Mode=OneWay}" />
                    </Grid>
                </Button>
            </StackPanel>
        </muxc:NavigationView.PaneFooter>
    </muxc:NavigationView>

</base:BaseUserControl>
