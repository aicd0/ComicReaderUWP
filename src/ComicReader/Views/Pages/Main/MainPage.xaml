<base:BasePage
    x:Class="ComicReader.Views.Pages.Main.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="using:ComicReader.Views.Pages.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitiveContract7Present="using:Microsoft.UI.Xaml.Controls.Primitives?IsApiContractPresent(Windows.Foundation.UniversalApiContract,7)"
    xmlns:reader="using:ComicReader.Views.Pages.Reader"
    xmlns:vm="using:ComicReader.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppBarButton.xaml" />
                <ResourceDictionary Source="/Styles/AppBarToggleButton.xaml" />
                <ResourceDictionary Source="/Styles/AutoSuggestBox.xaml" />
                <ResourceDictionary Source="/Styles/Button.xaml" />
                <ResourceDictionary Source="/Styles/TextBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

            <Style x:Name="TabViewButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource TabViewButtonBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource TabViewButtonForeground}" />
                <Setter Property="FontSize" Value="{ThemeResource TabViewItemAddButtonFontSize}" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="Width" Value="{ThemeResource TabViewItemAddButtonWidth}" />
                <Setter Property="Height" Value="{ThemeResource TabViewItemAddButtonHeight}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonBackgroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonForegroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonBackgroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonForegroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonBackgroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabViewButtonForegroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MainPageTabViewStyle" TargetType="muxc:TabView">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Padding" Value="{ThemeResource TabViewHeaderPadding}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Background" Value="{ThemeResource TabViewBackground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="muxc:TabView">
                            <Grid>
                                <ContentPresenter
                                    x:Name="TabContentPresenter"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Loaded="OnTabContentPresenterLoaded" />
                                <Grid
                                    x:Name="TabContainerGrid"
                                    VerticalAlignment="Top"
                                    Background="{TemplateBinding Background}"
                                    Loaded="OnTabContainerGridLoaded"
                                    SizeChanged="OnTabContainerGridSizeChanged"
                                    Unloaded="OnTabContainerGridUnloaded"
                                    XYFocusKeyboardNavigation="Enabled">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="LeftContentColumn" Width="Auto" />
                                        <ColumnDefinition x:Name="TabColumn" Width="Auto" />
                                        <ColumnDefinition x:Name="AddButtonColumn" Width="Auto" />
                                        <ColumnDefinition x:Name="RightContentColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        BorderBrush="{ThemeResource TabViewBorderBrush}"
                                        BorderThickness="1" />
                                    <ContentPresenter
                                        x:Name="LeftContentPresenter"
                                        Grid.Column="0"
                                        Content="{TemplateBinding TabStripHeader}"
                                        ContentTemplate="{TemplateBinding TabStripHeaderTemplate}" />
                                    <primitiveContract7Present:TabViewListView
                                        x:Name="TabListView"
                                        Grid.Column="1"
                                        Padding="{TemplateBinding Padding}"
                                        AllowDrop="{TemplateBinding AllowDropTabs}"
                                        CanDragItems="{TemplateBinding CanDragTabs}"
                                        CanReorderItems="{TemplateBinding CanReorderTabs}"
                                        ItemTemplate="{TemplateBinding TabItemTemplate}"
                                        ItemTemplateSelector="{TemplateBinding TabItemTemplateSelector}"
                                        ItemsSource="{TemplateBinding TabItemsSource}" />
                                    <Border
                                        Grid.Column="2"
                                        Padding="{ThemeResource TabViewItemAddButtonContainerPadding}"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding IsAddTabButtonVisible, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <Button
                                            x:Name="AddButton"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{TemplateBinding AddTabButtonCommand}"
                                            CommandParameter="{TemplateBinding AddTabButtonCommandParameter}"
                                            Content="&#xE710;"
                                            HighContrastAdjustment="None"
                                            IsTextScaleFactorEnabled="False"
                                            Style="{ThemeResource TabViewButtonStyle}" />
                                    </Border>
                                    <ContentPresenter
                                        x:Name="RightContentPresenter"
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        Content="{TemplateBinding TabStripFooter}"
                                        ContentTemplate="{TemplateBinding TabStripFooterTemplate}" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Escape"
            Invoked="KeyboardAccelerator_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="F10"
            Invoked="KeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="F11"
            Invoked="KeyboardAccelerator_Invoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!--  Content (immersive mode)  -->
        <Grid x:Name="ContentGridImmersive" />

        <!--  Navigation Bar & Sidebar  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TopTile"
                Grid.Row="0"
                VerticalAlignment="Top"
                Background="{ThemeResource TabViewItemHeaderBackgroundSelected}"
                SizeChanged="OnTopTileSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left buttons  -->
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <AppBarButton
                            Click="OnGoBackClick"
                            Icon="Back"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                            Style="{StaticResource NavigationPageTopTileAppBarButton}"
                            ToolTipService.ToolTip="{x:Bind StringResource.GoBack}" />
                        <AppBarButton
                            Click="OnGoForwardClick"
                            Icon="Forward"
                            IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                            Style="{StaticResource NavigationPageTopTileAppBarButton}"
                            ToolTipService.ToolTip="{x:Bind StringResource.GoForward}" />
                        <AppBarButton
                            x:Uid="HomeButton"
                            Click="OnHomeClick"
                            Icon="Home"
                            Style="{StaticResource NavigationPageTopTileAppBarButton}"
                            Visibility="{x:Bind ViewModel.IsHomePage, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                        <Grid Visibility="{x:Bind ViewModel.IsHomePage, Mode=OneWay}">
                            <AppBarButton
                                Click="OnRefreshClick"
                                Icon="Refresh"
                                Style="{StaticResource NavigationPageTopTileAppBarButton}"
                                ToolTipService.ToolTip="{x:Bind StringResource.Refresh}"
                                Visibility="{x:Bind ViewModel.Refreshing, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}" />
                            <AppBarButton Style="{StaticResource NavigationPageTopTileAppBarButton}" Visibility="{x:Bind ViewModel.Refreshing, Mode=OneWay}">
                                <ProgressRing Margin="-2" IsActive="True" />
                            </AppBarButton>
                        </Grid>
                    </StackPanel>

                    <!--  Search box  -->
                    <controls:ExtendedSearchBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinWidth="250"
                        Margin="15,0,15,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        QuerySubmitted="OnSearchBoxQuerySubmitted"
                        TextChanged="OnSearchBoxTextChanged" />

                    <!--  Right buttons  -->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  Open pane button  -->
                        <AppBarButton
                            Click="OnOpenSidebarClick"
                            Style="{StaticResource NavigationPageTopTileAppBarButton}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SidebarButtonText, Mode=OneWay}">
                            <AppBarButton.Content>
                                <FontIcon Glyph="{x:Bind ViewModel.SidebarButtonGlyph, Mode=OneWay}" />
                            </AppBarButton.Content>
                        </AppBarButton>

                        <!--  More button  -->
                        <AppBarButton
                            Flyout="{x:Bind ViewModel.MoreButtonFlyout, Mode=OneWay}"
                            Style="{StaticResource NavigationPageTopTileAppBarButton}"
                            ToolTipService.ToolTip="{x:Bind StringResource.More}">
                            <AppBarButton.Content>
                                <FontIcon Glyph="&#xE712;" />
                            </AppBarButton.Content>
                        </AppBarButton>

                    </StackPanel>

                </Grid>

                <!--  Center buttons  -->
                <StackPanel
                    x:Name="SpCenterButtons"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  Add to favorites  -->
                    <AppBarButton
                        x:Name="AbbAddToFavorite"
                        Click="OnAddToFavoritesClick"
                        Style="{StaticResource NavigationPageTopTileAppBarButton}">
                        <AppBarButton.Content>
                            <Grid>
                                <FontIcon x:Name="FiFavoriteUnfilled" Glyph="&#xE734;" />
                                <FontIcon
                                    x:Name="FiFavoriteFilled"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Glyph="&#xE735;" />
                            </Grid>
                        </AppBarButton.Content>
                    </AppBarButton>

                    <!--  Reader grid preview toggle  -->
                    <AppBarToggleButton
                        x:Name="AbtbPreviewButton"
                        Checked="AbtbPreviewButton_Checked"
                        Style="{StaticResource NavigationPageTopTileAppBarToggleButton}"
                        ToolTipService.ToolTip="{x:Bind StringResource.AllPages}"
                        Unchecked="AbtbPreviewButton_Unchecked">
                        <AppBarToggleButton.Content>
                            <FontIcon Glyph="&#xF0E2;" />
                        </AppBarToggleButton.Content>
                    </AppBarToggleButton>

                    <!--  Reader settings  -->
                    <AppBarButton x:Uid="ReaderSettingButton" Style="{StaticResource NavigationPageTopTileAppBarButton}">
                        <AppBarButton.Content>
                            <FontIcon Glyph="&#xE713;" />
                        </AppBarButton.Content>
                        <AppBarButton.Flyout>
                            <Flyout Closing="ReaderSettingFlyout_Closing">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="14,12,14,12" />
                                        <Setter Property="MaxWidth" Value="1000" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <reader:ReaderSettingPanel x:Name="MainReaderSettingPanel" DataChanged="MainReaderSettingPanel_DataChanged" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <!--  Comic info  -->
                    <AppBarButton
                        Click="OnComicInfoClick"
                        Style="{StaticResource NavigationPageTopTileAppBarButton}"
                        ToolTipService.ToolTip="{x:Bind StringResource.ComicInfo}">
                        <AppBarButton.Content>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Content>
                    </AppBarButton>

                </StackPanel>

                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource NavigationPageTopTileBorderBrush}" />

            </Grid>

            <SplitView
                x:Name="NavigationPageSidePane"
                Grid.Row="1"
                Margin="0,0,-2,0"
                DisplayMode="Overlay"
                OpenPaneLength="380"
                PaneBackground="{ThemeResource FlyoutPresenterBackground}"
                PaneClosed="NavigationPageSidePane_PaneOpenedOrClosed"
                PaneOpened="NavigationPageSidePane_PaneOpenedOrClosed"
                PanePlacement="Right">
                <SplitView.Pane>
                    <Grid SizeChanged="NavigationPageSidePane_SizeChanged">
                        <main:SidePaneView x:Name="RightSidePane" PinStateChanged="RightSidePane_PinStateChanged" />
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource SidePaneBorderBrush}" />
                        <cwc:PropertySizer
                            HorizontalAlignment="Left"
                            Binding="{x:Bind NavigationPageSidePane.OpenPaneLength, Mode=TwoWay}"
                            IsDragInverted="True"
                            Minimum="360"
                            Opacity="0" />
                    </Grid>
                </SplitView.Pane>

                <Grid x:Name="ContentGridNormal">
                    <Grid
                        x:Name="ContentGrid"
                        PointerPressed="OnPagePointerPressed"
                        PointerReleased="OnPagePointerReleased" />
                </Grid>

            </SplitView>

        </Grid>

        <!--  Tabs  -->
        <muxc:TabView
            x:Name="RootTabView"
            VerticalAlignment="Stretch"
            AddTabButtonClick="OnAddTabButtonClicked"
            AllowDrop="True"
            CanDragTabs="True"
            DragOver="OnRootTabViewDragOver"
            Drop="OnRootTabViewDrop"
            SelectionChanged="OnTabViewSelectionChanged"
            Style="{StaticResource MainPageTabViewStyle}"
            TabCloseRequested="OnTabCloseRequested"
            TabDragStarting="OnRootTabViewTabDragStarting"
            TabDroppedOutside="OnRootTabViewTabDroppedOutside">
            <muxc:TabView.TabStripFooter>
                <main:TitleBar x:Name="MainTitleBar" />
            </muxc:TabView.TabStripFooter>
        </muxc:TabView>

        <!--  Fullscreen button  -->
        <Grid
            x:Name="FullscreenButtonGrid"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            PointerEntered="FullscreenButtonGrid_PointerEntered">
            <Button
                Click="OnFullscreenBtClicked"
                Style="{StaticResource ReaderFullscreenButtonStyle}"
                Visibility="{x:Bind ViewModel.IsFullscreen, Converter={StaticResource BooleanToVisibilityNegationConverter}, Mode=OneWay}">
                <Button.Content>
                    <FontIcon Glyph="&#xE740;" />
                </Button.Content>
            </Button>
            <Button
                Click="OnBackToWindowBtClicked"
                Style="{StaticResource ReaderFullscreenButtonStyle}"
                Visibility="{x:Bind ViewModel.IsFullscreen, Mode=OneWay}">
                <Button.Content>
                    <FontIcon Glyph="&#xE73F;" />
                </Button.Content>
            </Button>
        </Grid>

        <!--  Busy indicator  -->
        <Grid Background="{ThemeResource BusyBackground}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <!--  Logs  -->
        <ListView
            x:Name="LogListView"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            ItemsSource="{x:Bind ViewModel.LogItems}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            Visibility="{x:Bind ViewModel.IsLogVisible, Mode=OneWay}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogItemViewModel">
                    <Grid HorizontalAlignment="Left" Background="#90000000">
                        <TextBlock Foreground="#B0FFFFFF" Text="{x:Bind Text}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</base:BasePage>
