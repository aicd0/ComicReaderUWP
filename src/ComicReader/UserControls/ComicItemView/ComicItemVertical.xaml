<base:BaseUserControl
    x:Class="ComicReader.UserControls.ComicItemView.ComicItemVertical"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwm="using:CommunityToolkit.WinUI.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ComicReader.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ComicItemViewModel}"
    Loaded="UserControl_Loaded"
    Tapped="UserControl_Tapped"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

            <cwm:AttachedCardShadow
                x:Key="CommonShadow"
                Opacity="0.1"
                Offset="0" />

        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ComicItemBackground}"
        ContextRequested="RootGrid_ContextRequested"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        Tapped="RootGrid_Tapped">
        <Grid.BackgroundTransition>
            <BrushTransition Duration="0:0:0.1" />
        </Grid.BackgroundTransition>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="100" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20,32,20,0">
                <Grid Height="{StaticResource ComicItemVerticalImageHeight}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid cw:Effects.Shadow="{StaticResource CommonShadow}">
                            <Image x:Name="ImageHolder1" Opacity="0" />
                        </Grid>
                        <Border CornerRadius="5">
                            <Image x:Name="ImageHolder2" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Margin="10,0,10,14"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="3">
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="14"
                    FontWeight="SemiBold"
                    MaxLines="3"
                    Text="{x:Bind Item.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}" />
                <Viewbox
                    Height="12"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Item.IsRatingVisible, Mode=OneWay}">
                    <controls:ReadonlyRatingView Height="20" PlaceholderValue="{x:Bind Item.Rating, Mode=OneWay}" />
                </Viewbox>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiLight"
                    Opacity="0.6"
                    Text="{x:Bind Item.PageCountAndProgress, Mode=OneWay}" />
            </StackPanel>

            <Grid
                Grid.Row="0"
                Margin="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{x:Bind Item.IsFavorite, Mode=OneWay}">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemAccentColor}"
                    Glyph="&#xE735;" />
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ComicItemBackground}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Background" Value="{ThemeResource ComicItemBackgroundPointerOver}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</base:BaseUserControl>
