<base:BaseUserControl
    x:Class="ComicReader.UserControls.ComicItemView.ComicItemHorizontal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:ComicReader.Common.BaseUI"
    xmlns:controls="using:ComicReader.UserControls"
    xmlns:converters="using:ComicReader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="UserControl_Loaded"
    Tapped="UserControl_Tapped"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <base:BaseUserControl.Resources>
        <ResourceDictionary>

            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter" />

        </ResourceDictionary>
    </base:BaseUserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="10,8"
        Background="Transparent"
        ContextRequested="RootGrid_ContextRequested"
        Tapped="RootGrid_Tapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="{StaticResource ComicItemHorizontalImageWidth}">
            <Rectangle Fill="{ThemeResource ImagePlaceHolderBackground}" />
            <Image x:Name="ImageHolder" Stretch="UniformToFill" />
        </Grid>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Padding="12,2,8,5"
            Orientation="Vertical"
            Spacing="3">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="14"
                FontWeight="SemiBold"
                MaxLines="3"
                Text="{x:Bind Item.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Opacity="0.6"
                Orientation="Horizontal"
                Visibility="{x:Bind Item.IsRatingVisible, Mode=OneWay}">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind Item.Rating, Mode=OneWay}" />
                <FontIcon
                    Margin="4,1,0,0"
                    FontSize="9"
                    Glyph="&#xE735;" />
            </StackPanel>
            <TextBlock
                FontSize="12"
                FontWeight="SemiLight"
                Opacity="0.6"
                Text="{x:Bind Item.PageCountAndProgress, Mode=OneWay}" />
        </StackPanel>

        <Grid
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind Item.IsFavorite, Mode=OneWay}">
            <FontIcon
                Margin="0,0,10,8"
                FontSize="14"
                Foreground="{ThemeResource SystemAccentColor}"
                Glyph="&#xE735;" />
        </Grid>

    </Grid>

</base:BaseUserControl>
