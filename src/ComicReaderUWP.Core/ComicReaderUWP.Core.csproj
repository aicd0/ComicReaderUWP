<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>x86;x64;ARM64</Platforms>
		<TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
	</PropertyGroup>

	<Target Name="CopyNativeMethods" BeforeTargets="BeforeBuild">
		<Copy SourceFiles="NativeMethods.$(Platform).txt" DestinationFiles="NativeMethods.txt" />
	</Target>
	<ItemGroup>
		<AdditionalFiles Include="NativeMethods.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
		<PackageReference Include="Sentry" Version="7.0.0" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="11.0.0" />
		<PackageReference Include="System.IO.Hashing" Version="11.0.0" />
		<PackageReference Include="System.Management" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ComicReaderUWP.SDK\ComicReaderUWP.SDK.csproj" />
	</ItemGroup>

</Project>
